# ---------------------------------------------------------------------------
# Configuración de Apache / LiteSpeed para la SPA de Angular en /pvn/
# Este archivo se copia al build (angular.json -> assets) y el despliegue
# por FTP lo sube junto al resto, así que se actualiza solo.
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /pvn/

  # 1) Si la petición es un ARCHIVO real (main.abc.js, styles.abc.css,
  #    favicon.ico, assets/..., media/...) se sirve tal cual.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2) Todo lo demás (rutas de Angular como /pvn/dashboard/personal) se sirve
  #    con index.html para que el router de Angular las resuelva en el navegador.
  #
  #    Ojo: a propósito NO se respeta el caso "-d" (carpetas reales). Así las
  #    carpetas prerenderizadas antiguas (dashboard/, login/, ...) que pudieran
  #    quedar en el servidor dejan de servirse y nunca exponen datos sin sesión.
  RewriteRule ^ index.html [L]
</IfModule>

# El index.html nunca se guarda en caché: si no, tras cada despliegue los
# usuarios seguirían viendo la versión anterior de la aplicación.
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# Los archivos con hash en el nombre nunca cambian: se pueden cachear un año.
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "\.(js|css|woff|woff2|ttf|eot|svg|png|jpe?g|gif|webp|ico)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpe?g|gif|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Compresión de texto (acelera bastante la primera carga).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# Nada de listar directorios.
Options -Indexes
